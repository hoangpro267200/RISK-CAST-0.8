apiVersion: v1
kind: Secret
metadata:
  name: riskcast-secrets
  namespace: riskcast
type: Opaque
stringData:
  # Database connection (MySQL)
  DATABASE_URL: "mysql+pymysql://riskcast:CHANGE_ME@mysql-service:3306/riskcast_v3?charset=utf8mb4"
  
  # Database root password (for MySQL)
  DB_ROOT_PASSWORD: "CHANGE_ME_ROOT_PASSWORD"
  
  # Redis (optional)
  REDIS_URL: "redis://redis-service:6379/0"
  
  # Application secrets
  SECRET_KEY: "CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
  SESSION_SECRET_KEY: "CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32"
  
  # External API Keys (optional)
  TOMORROW_IO_API_KEY: ""
  MARINETRAFFIC_API_KEY: ""
  PROJECT44_API_KEY: ""
  ICEYE_API_KEY: ""
  FLOODBASE_API_KEY: ""
  
  # Database credentials (if not in DATABASE_URL)
  DB_USER: "riskcast"
  DB_PASSWORD: "CHANGE_ME"
  DB_NAME: "riskcast_v3"
